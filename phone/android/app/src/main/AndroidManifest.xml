<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- a view's camera and microphone pieces (crates/av), asked when one first opens -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- the ring (Ring.kt): a call's notification, and its screen over a locked phone -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" android:version="0x00400003" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- the camera is a view's, not the app's: a phone without one (or without autofocus) installs it too -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:label="ducktape"
        android:supportsRtl="true"
        android:theme="@style/Phone">

        <!-- configChanges: the Activity is never recreated for these, so gm
             keeps one host id and its window (uiMode reaches gm through
             Native.configuration) -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- links: the chain's own scheme, and the Expo build's (wasm-mobile SPEC §7.6) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="duck" />
                <data android:scheme="ducktape" />
            </intent-filter>
        </activity>

        <!-- MainActivity as only this app starts it (Ring.kt, RingActivity.kt): a call's Answer or tap, and a notice
             opened from the shade, come in by it. The one way a ring is taken down or a notice's payload reaches the
             Notifications tab (MainActivity reads neither from any other intent): no other app can start it -->
        <activity-alias
            android:name=".Own"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- the ring (Ring.kt): a call's screen over a locked phone (its own task, out of Recents), its Decline, and
             the owner's Firebase project's messages -->
        <activity
            android:name=".RingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="" />
        <receiver android:name=".Ring$Decline" android:exported="false" />
        <service android:name=".Ring$Messages" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
